# =================================================================
# Trading Intelligence System Environment Variables (.env)
# =================================================================

# Server Port
SERVER_PORT=8080

# -----------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------
# 1) Default: In-Memory H2 (MySQL Mode - Zero Setup)
SPRING_DATASOURCE_URL=jdbc:h2:mem:testdb;MODE=MySQL;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_DRIVER=org.h2.Driver
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=

# 2) Alternative: Local or Cloud MySQL Database
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/springai?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
# SPRING_DATASOURCE_DRIVER=com.mysql.cj.jdbc.Driver
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=1234

# -----------------------------------------------------------------
# Spring AI & Ollama (Local LLM / Nosana Remote GPU Node)
# -----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:14b
EMBEDDING_MODEL=bge-m3:latest

# -----------------------------------------------------------------
# ChromaDB Vector Store
# -----------------------------------------------------------------
CHROMADB_HOST=http://localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=financial-market-news

# -----------------------------------------------------------------
# Bright Data Web Intelligence & Realtime Scraping API
# -----------------------------------------------------------------
BRIGHTDATA_API_KEY=4a62ad76-a8e4-46cb-9cb0-deaf9e6587a7
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_ENABLED=true

# -----------------------------------------------------------------
# Trading Rate Limiting (Daily Free Quota)
# -----------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DAILY_LIMIT=3

