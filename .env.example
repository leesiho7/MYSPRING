# =================================================================
# Trading Intelligence System Environment Variables (.env)
# =================================================================

# Server Port
SERVER_PORT=8080

# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=springai
MYSQL_USERNAME=root
MYSQL_PASSWORD=1234
# Optional Full JDBC URL:
# MYSQL_URL=jdbc:mysql://localhost:3306/springai?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Spring AI & Ollama (Local LLM / Nosana Remote GPU Node)
OLLAMA_BASE_URL=http://localhost:11434
CHAT_MODEL=qwen2.5:14b
EMBEDDING_MODEL=bge-m3:latest

# ChromaDB Vector Store
CHROMADB_HOST=http://localhost
CHROMADB_PORT=8000
CHROMADB_COLLECTION=financial-market-news

# Bright Data Web Intelligence & Realtime Scraping API
BRIGHTDATA_API_KEY=4a62ad76-a8e4-46cb-9cb0-deaf9e6587a7
BRIGHTDATA_BASE_URL=https://api.brightdata.com
BRIGHTDATA_ENABLED=true

# Trading Rate Limiting (Daily Free Quota)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DAILY_LIMIT=3
